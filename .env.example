# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2

# Hugging Face embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# RAG
RETRIEVAL_K=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Upload
MAX_UPLOAD_SIZE_MB=25
